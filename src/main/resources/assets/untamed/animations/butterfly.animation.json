{
	"format_version": "1.8.0",
	"animations": {
		"animation.butterfly.idle": {
			"loop": true,
			"animation_length": 4,
			"bones": {
				"body_del": {
					"position": { "vector": [0, "math.cos(query.anim_time * 90) * 0.05", 0] }
				},
				"ala_der": { "rotation": { "vector": [0, 0, "math.cos(query.anim_time * 180) * 12"] } },
				"ala_izq": { "rotation": { "vector": [0, 0, "math.cos(query.anim_time * 180) * -12"] } },
				"ala_der_tra": { "rotation": { "vector": [0, 0, "math.cos((query.anim_time - 0.2) * 180) * 10"] } },
				"ala_izq_tra": { "rotation": { "vector": [0, 0, "math.cos((query.anim_time - 0.2) * 180) * -10"] } },
				"antena_der": { "rotation": { "vector": ["math.sin(query.anim_time * 90) * 4", "math.cos(query.anim_time * 90) * 2", 0] } },
				"antena_izq": { "rotation": { "vector": ["math.sin(query.anim_time * 90) * 4", "math.cos(query.anim_time * 90) * -2", 0] } }
			}
		},
		"animation.butterfly.fly": {
			"loop": true,
			"animation_length": 1,
			"bones": {
				"root": {
					"position": { 
						"vector": [
							"math.sin(query.anim_time * 360) * 0.15", 
							"math.sin(query.anim_time * 720) * 0.3", 
							"math.cos(query.anim_time * 360) * 0.1"
						] 
					},
					"rotation": { 
						"vector": [
							"-10 + math.sin(query.anim_time * 360) * 5", 
							0, 
							"math.cos(query.anim_time * 360) * 8"
						] 
					}
				},
				"ala_der": { "rotation": { "vector": [0, "-math.sin(query.anim_time * 1440) * 15", "math.sin(query.anim_time * 1440) * 65"] } },
				"ala_izq": { "rotation": { "vector": [0, "math.sin(query.anim_time * 1440) * 15", "math.sin(query.anim_time * 1440) * -65"] } },
				"ala_der_tra": { "rotation": { "vector": [0, 0, "math.sin((query.anim_time - 0.08) * 1440) * 50"] } },
				"ala_izq_tra": { "rotation": { "vector": [0, 0, "math.sin((query.anim_time - 0.08) * 1440) * -50"] } },
				"body_del": { "rotation": { "vector": ["math.sin(query.anim_time * 1440) * 3", 0, 0] } },
				"body_tra": { "rotation": { "vector": ["math.cos(query.anim_time * 1440) * 5", 0, 0] } }
			}
		},
		"animation.butterfly.pollinate": {
			"loop": true,
			"animation_length": 2,
			"bones": {
				"body_del": {
					"position": { "vector": [0, "-0.25 + math.sin(query.anim_time * 360) * 0.03", 0] },
					"rotation": { "vector": [15, 0, 0] }
				},
				"cabeza": {
					"rotation": { "vector": ["12 + math.cos(query.anim_time * 1440) * 4", 0, 0] }
				},
				"ala_der": { "rotation": { "vector": [0, 0, "65 + math.sin(query.anim_time * 720) * 10"] } },
				"ala_izq": { "rotation": { "vector": [0, 0, "-65 + math.sin(query.anim_time * 720) * -10"] } },
				"ala_der_tra": { "rotation": { "vector": [0, 0, "55 + math.sin((query.anim_time - 0.1) * 720) * 8"] } },
				"ala_izq_tra": { "rotation": { "vector": [0, 0, "-55 + math.sin((query.anim_time - 0.1) * 720) * -8"] } },
				"antena_der": { "rotation": { "vector": ["15 + math.sin(query.anim_time * 360) * 2", 0, 0] } },
				"antena_izq": { "rotation": { "vector": ["15 + math.sin(query.anim_time * 360) * 2", 0, 0] } }
			}
		}
	},
	"geckolib_format_version": 2
}